# Server-only settings. Empty values keep every agenda API unavailable.
# Setting these requires verified business facts, exact deployed origin(s), and
# separate approval of the same-Site administrator subject. Never use email or
# the Site access-policy account ID as a subject. No fixture mode is supported.
AGENDA_CONFIG_JSON=
AGENDA_ADMIN_SUBJECTS_JSON=
AGENDA_ALLOWED_ORIGINS_JSON=
