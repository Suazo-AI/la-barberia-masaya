        "agenda_entries_kind": {
          "name": "agenda_entries_kind",
          "value": "kind IN ('booking', 'walk-in', 'block')"
        },
        "agenda_entries_start": {
          "name": "agenda_entries_start",
          "value": "typeof(start_utc) = 'integer'"
        },
        "agenda_entries_end": {
          "name": "agenda_entries_end",
          "value": "typeof(end_utc) = 'integer' AND end_utc > start_utc"
        },
        "agenda_entries_allocated_start": {
          "name": "agenda_entries_allocated_start",
          "value": "typeof(allocated_start_utc) = 'integer' AND allocated_start_utc <= start_utc"
        },
        "agenda_entries_allocated_end": {
          "name": "agenda_entries_allocated_end",
          "value": "typeof(allocated_end_utc) = 'integer' AND allocated_end_utc >= end_utc"
        },
        "agenda_entries_buffer_before": {
          "name": "agenda_entries_buffer_before",
          "value": "typeof(buffer_before_minutes) = 'integer' AND buffer_before_minutes >= 0"
        },
        "agenda_entries_buffer_after": {
          "name": "agenda_entries_buffer_after",
          "value": "typeof(buffer_after_minutes) = 'integer' AND buffer_after_minutes >= 0"
        },
        "agenda_entries_currency": {
          "name": "agenda_entries_currency",
          "value": "currency = 'NIO'"
        },
        "agenda_entries_status": {
          "name": "agenda_entries_status",
          "value": "status IN ('confirmed', 'cancelled')"
        },
        "agenda_entries_version": {
          "name": "agenda_entries_version",
          "value": "typeof(version) = 'integer' AND version >= 1"
        },
        "agenda_entries_management_hash": {
          "name": "agenda_entries_management_hash",
          "value": "management_hash IS NULL OR length(management_hash) = 64"
        },
        "agenda_entries_allocated_interval": {
          "name": "agenda_entries_allocated_interval",
          "value": "allocated_start_utc = start_utc - buffer_before_minutes * 60 AND allocated_end_utc = end_utc + buffer_after_minutes * 60"
        },
        "agenda_entries_kind_fields": {
          "name": "agenda_entries_kind_fields",
          "value": "\n    (kind = 'block' AND service_id IS NULL AND service_name IS NULL\n      AND duration_minutes IS NULL AND price_minor_units IS NULL\n      AND customer_display_name IS NULL AND customer_email IS NULL\n      AND management_hash IS NULL AND buffer_before_minutes = 0 AND buffer_after_minutes = 0 AND block_label IS NOT NULL)\n    OR\n    (kind IN ('booking', 'walk-in') AND service_id IS NOT NULL AND service_name IS NOT NULL\n      AND typeof(duration_minutes) = 'integer' AND duration_minutes > 0\n      AND end_utc - start_utc = duration_minutes * 60\n      AND typeof(price_minor_units) = 'integer' AND price_minor_units >= 0\n      AND block_label IS NULL)\n  "
        }
      }
